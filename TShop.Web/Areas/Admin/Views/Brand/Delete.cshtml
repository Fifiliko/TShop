@model TShop.Web.ViewModels.BrandVM
@{
    ViewData["Title"] = "Delete Brand";
}
<div class="max-w-xl mx-auto mt-10 p-6 bg-white shadow-md rounded-xl">
    <h2 class="text-2xl font-semibold mb-6 text-red-600">Delete Confirmation</h2>
    <p class="mb-4 text-gray-700">Are you sure you want to delete this brand?</p>
    <div class="mb-4">
        <strong>ID:</strong> @Model.Id
    </div>
    <div class="mb-4">
        <strong>Name:</strong> @Model.Name
    </div>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <p class="mb-4 text-gray-700">Are you sure you want to delete brand "<strong>@Model.Name</strong>"?</p>
        <div class="flex justify-end">
            <a asp-action="Index" class="bg-gray-200 text-gray-800 px-4 py-2 rounded-lg hover:bg-gray-300 mr-2">Cancel</a>
            <button type="submit" class="bg-red-600 text-white px-5 py-2 rounded-lg hover:bg-red-700">Delete</button>
        </div>
    </form>

</div>
