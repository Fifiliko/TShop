@model TShop.Web.ViewModels.BrandVM

<div class="max-w-xl mx-auto p-6 bg-white rounded-2xl shadow-md">
    <h2 class="text-2xl font-semibold text-gray-800 mb-6">Brand Form</h2>

    <form asp-action="Create" method="post" class="space-y-5">
        <div>
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">Brand Name</label>
            <input asp-for="Name" class="w-full border border-gray-300 px-4 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm" placeholder="Enter brand name" />
            <span asp-validation-for="Name" class="text-sm text-red-500"></span>
        </div>

        <div class="flex justify-end">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-2 rounded-lg shadow transition duration-200">
                Save Brand
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
