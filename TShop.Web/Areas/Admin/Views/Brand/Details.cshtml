@model TShop.Web.ViewModels.BrandVM

@{
    ViewData["Title"] = "Brand Details";
}

<div class="max-w-xl mx-auto p-6 bg-white rounded-xl shadow-md mt-10">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Brand Details</h2>

    <div class="space-y-4">
        <div>
            <span class="block text-sm font-medium text-gray-600">ID</span>
            <p class="text-lg text-gray-800 font-semibold">@Model.Id</p>
        </div>
        <div>
            <span class="block text-sm font-medium text-gray-600">Name</span>
            <p class="text-lg text-gray-800 font-semibold">@Model.Name</p>
        </div>
    </div>

    <div class="mt-8 flex justify-between">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">Edit</a>
        <a asp-action="Index" class="inline-block bg-gray-300 text-gray-800 px-4 py-2 rounded-lg hover:bg-gray-400 transition">Back to List</a>
    </div>
</div>
